COPY ./code/patch/tensordict.patch /tmp/tensordict.patch
RUN cd /opt/pyvenv/lib/python3.10/site-packages ;\
    patch -p0 < /tmp/tensordict.patch | tee /root/build_tensordict.log

# COPY ./code/file/mc2_env.yaml /opt/verl/verl/trainer/
# COPY ./code/file/dapo_trainer-megatron.yaml /opt/verl/recipe/dapo/config/

RUN echo "PS1='\${debian_chroot:+(\$debian_chroot)}\[\033[01;32m\]\u@\[\033[00m\]\[\033[01;33m\]Verl-Unify@\[\033[00m\]\[\033[01;35m\]\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\\\$ '" >> ~/.bashrc



