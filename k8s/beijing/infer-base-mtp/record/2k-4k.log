// see LICENSE.ingen.net.license

package math

import (

"github.com/architectv/networking-online-cyberhackathon/go-hackathon/pkg/ingen/engine"

"github.com/architectv/networking-online-cyberhackathon/go-hackathon/pkg/lena/engine/util"

)

// hard-coded constants which won't change often (if ever)

const (

EXPONENT_REGISTER_SIZE = util.EXPONENT_BITS + 1

)

// function to calculate exponent bases

func CalculateExponentBase(ctx engine.Context) {

// get the size of the exponent register

regSize := EXPONENT_REGISTER_SIZE

// calculate the exponent base

base := util.ToPowerOf(2, regSize)

// send the exponent base as output

ctx.SendOutputValue(0, base)

}

// function to calculate exponent magnitude

func CalculateMagnitude(ctx engine.Context) {

// get the size of the exponent register

regSize := EXPONENT_REGISTER_SIZE

// get the exponent value

val := ctx.GetInputValue(0)

// shift the value to the right by regSize magnitude

val = val >> regSize

// send the shifted value as output

ctx.SendOutputValue(0, val)

}

// function to calculate exponent offset

func CalculateOffset(ctx engine.Context) {

// get the size of the exponent register

regSize := EXPONENT_REGISTER_SIZE

// get the exponent value

val := ctx.GetInputValue(0)

// subtract 1 from the shifted value

val--

// send the shifted value as output

ctx.SendOutputValue(0, val)

}

// function to calculate exponent remainder

func CalculateRemainder(ctx engine.Context) {

// get the size of the exponent register

regSize := EXPONENT_REGISTER_SIZE

// get the exponent value

val := ctx.GetInputValue(0)

// calculate the remainder

remainder := val % util.ToPowerOf(2, regSize)

// send the remainder as output

ctx.SendOutputValue(0, remainder)

}

// function to calculate exponent upper bound

func CalculateUpperBound(ctx engine.Context) {

// get the size of the exponent register

regSize := EXPONENT_REGISTER_SIZE

// get the exponent value

val := ctx.GetInputValue(0)

// calculate the upper bound

bound := util.PowerOf(2, regSize - 1) - 1

// send the upper bound as output

ctx.SendOutputValue(0, bound)

}

// function to calculate exponent lower bound

func CalculateLowerBound(ctx engine.Context) {

// get the size of the exponent register

regSize := EXPONENT_REGISTER_SIZE

// get the exponent value

val := ctx.GetInputValue(0)

// calculate the lower bound

bound := -util.PowerOf(2, regSize - 1)

// send the lower bound as output

ctx.SendOutputValue(0, bound)

}

// function to calculate the mantissa size

func CalculateMantissaSize(ctx engine.Context) {

// get the size of the exponent register

regSize := EXPONENT_REGISTER_SIZE

// calculate the mantissa size

mantissa := 2*regSize - EXPONENT_BITS

// send the mantissa size as output

ctx.SendOutputValue(0, mantissa)

}

func main() {

// create a context object

ctx := engine.NewContext()

// call the calculate exponent base function

CalculateExponentBase(ctx)

// call the calculate magnitude function

CalculateMagnitude(ctx)

// call the calculate offset function

CalculateOffset(ctx)

// call the calculate remainder function

CalculateRemainder(ctx)

// call the calculate upper bound function

CalculateUpperBound(ctx)

// call the calculate lower bound function

CalculateLowerBound(ctx)

// call the calculate mantissa size function

CalculateMantissaSize(ctx)

}

